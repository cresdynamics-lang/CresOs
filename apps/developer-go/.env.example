# Developer workspace (Go) — Promage-style HTML dashboard
#
# Run:
#   cd apps/developer-go
#   cp .env.example .env
#   go run ./cmd/server
#
# Default: http://localhost:4200

PORT=4200
DATABASE_URL=postgresql://cresos:cresos@localhost:5435/cresos
JWT_SECRET=dev-secret
COOKIE_NAME=cresos_developer_token
APP_NAME=CresOS Developer
# Production behind nginx: BASE_PATH=/w/developer and SECURE_COOKIE=true
# BASE_PATH=
# SECURE_COOKIE=false
# PUBLIC_WEB_URL=http://localhost:3000
