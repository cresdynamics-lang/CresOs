# API base URL (no trailing slash; defaults to http://localhost:4000 if unset).
# On HTTPS deployments use an https:// API URL or a same-origin reverse proxy — browsers block http:// API calls from https:// pages.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Optional Go workspaces — pure sales / developer logins hand off via /sso?token=
# Production (same host via nginx):
# NEXT_PUBLIC_SALES_GO_URL=https://cresos.cresdynamics.com/w/sales
# NEXT_PUBLIC_DEVELOPER_GO_URL=https://cresos.cresdynamics.com/w/developer
# Local:
NEXT_PUBLIC_SALES_GO_URL=http://localhost:4100
NEXT_PUBLIC_DEVELOPER_GO_URL=http://localhost:4200
