# Sales workspace (Go) — HTML + API
#
# Full sales dashboard served by Go (options 2+3): overview, CRM, invoices,
# leads, deals, reports, messages — same Postgres + JWT as the Node API.
#
# Run (from repo root, with Postgres up):
#   cd apps/sales-go
#   cp .env.example .env   # point DATABASE_URL / JWT_SECRET at local API .env
#   go run ./cmd/server
#
# Default: http://localhost:4100

PORT=4100
DATABASE_URL=postgresql://cresos:cresos@localhost:5435/cresos
JWT_SECRET=dev-secret
COOKIE_NAME=cresos_sales_token
APP_NAME=CresOS Sales
